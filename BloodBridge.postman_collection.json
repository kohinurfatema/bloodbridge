{
  "info": {
    "name": "BloodBridge API",
    "description": "Blood Donation & Emergency Platform — REST API documentation for all endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://bloodbridge-rove.onrender.com",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Test@1234\",\n  \"role\": \"DONOR\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Test@1234\"\n}"
            }
          }
        },
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('adminToken', json.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bloodbridge.com\",\n  \"password\": \"Admin@1234\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["auth", "refresh-token"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"<your_refresh_token>\"\n}"
            }
          }
        },
        {
          "name": "Google Auth",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/google", "host": ["{{baseUrl}}"], "path": ["auth", "google"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"<google_id_token>\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\",\n  \"phone\": \"+8801700000000\"\n}"
            }
          }
        },
        {
          "name": "Get User By ID (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/users/:id",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":id"],
              "variable": [{ "key": "id", "value": "<user_id>" }]
            }
          }
        }
      ]
    },
    {
      "name": "Donors",
      "item": [
        {
          "name": "Search Donors",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/donors?bloodType=A+&city=Dhaka&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["donors"],
              "query": [
                { "key": "bloodType", "value": "A+" },
                { "key": "city", "value": "Dhaka" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Register Donor Profile",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/donors/register", "host": ["{{baseUrl}}"], "path": ["donors", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bloodType\": \"A+\",\n  \"city\": \"Dhaka\",\n  \"lastDonation\": \"2025-01-01\",\n  \"isAvailable\": true\n}"
            }
          }
        },
        {
          "name": "Get My Donor Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/donors/me", "host": ["{{baseUrl}}"], "path": ["donors", "me"] }
          }
        },
        {
          "name": "Update My Donor Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/donors/me", "host": ["{{baseUrl}}"], "path": ["donors", "me"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isAvailable\": false,\n  \"city\": \"Chittagong\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Blood Requests",
      "item": [
        {
          "name": "Create Blood Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/requests", "host": ["{{baseUrl}}"], "path": ["requests"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bloodType\": \"B+\",\n  \"hospital\": \"Dhaka Medical College\",\n  \"city\": \"Dhaka\",\n  \"urgency\": \"HIGH\",\n  \"neededBy\": \"2026-09-15T10:00:00.000Z\",\n  \"notes\": \"Patient needs blood urgently after surgery\"\n}"
            }
          }
        },
        {
          "name": "List Blood Requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/requests?bloodType=B+&city=Dhaka&status=OPEN&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["requests"],
              "query": [
                { "key": "bloodType", "value": "B+" },
                { "key": "city", "value": "Dhaka" },
                { "key": "status", "value": "OPEN" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get My Requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/requests/my", "host": ["{{baseUrl}}"], "path": ["requests", "my"] }
          }
        },
        {
          "name": "Get Request By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/requests/:id",
              "host": ["{{baseUrl}}"],
              "path": ["requests", ":id"],
              "variable": [{ "key": "id", "value": "<request_id>" }]
            }
          }
        },
        {
          "name": "Update Request Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/requests/:id/status",
              "host": ["{{baseUrl}}"],
              "path": ["requests", ":id", "status"],
              "variable": [{ "key": "id", "value": "<request_id>" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"FULFILLED\"\n}"
            }
          }
        },
        {
          "name": "Delete Request",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/requests/:id",
              "host": ["{{baseUrl}}"],
              "path": ["requests", ":id"],
              "variable": [{ "key": "id", "value": "<request_id>" }]
            }
          }
        }
      ]
    },
    {
      "name": "Matches",
      "item": [
        {
          "name": "Create Match (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/matches", "host": ["{{baseUrl}}"], "path": ["matches"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"<blood_request_id>\",\n  \"donorId\": \"<donor_user_id>\",\n  \"donorProfileId\": \"<donor_profile_id>\"\n}"
            }
          }
        },
        {
          "name": "Get My Matches (Donor)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/matches/my?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["matches", "my"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Matches For Request",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/matches/request/:requestId",
              "host": ["{{baseUrl}}"],
              "path": ["matches", "request", ":requestId"],
              "variable": [{ "key": "requestId", "value": "<request_id>" }]
            }
          }
        },
        {
          "name": "Respond to Match (Donor)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/matches/:id/respond",
              "host": ["{{baseUrl}}"],
              "path": ["matches", ":id", "respond"],
              "variable": [{ "key": "id", "value": "<match_id>" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"response\": \"ACCEPTED\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Alerts",
      "item": [
        {
          "name": "Create Emergency Alert (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/alerts", "host": ["{{baseUrl}}"], "path": ["alerts"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"<blood_request_id>\"\n}"
            }
          }
        },
        {
          "name": "List Alerts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/alerts?active=true&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["alerts"],
              "query": [
                { "key": "active", "value": "true" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Resolve Alert (Admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/alerts/:id/resolve",
              "host": ["{{baseUrl}}"],
              "path": ["alerts", ":id", "resolve"],
              "variable": [{ "key": "id", "value": "<alert_id>" }]
            }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Initiate Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/payments/initiate", "host": ["{{baseUrl}}"], "path": ["payments", "initiate"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"<blood_request_id>\",\n  \"amount\": 500,\n  \"currency\": \"usd\"\n}"
            }
          }
        },
        {
          "name": "Verify Payment",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/payments/verify?session_id=<stripe_session_id>",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "verify"],
              "query": [{ "key": "session_id", "value": "<stripe_session_id>" }]
            }
          }
        },
        {
          "name": "Get My Payments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/payments/my", "host": ["{{baseUrl}}"], "path": ["payments", "my"] }
          }
        }
      ]
    },
    {
      "name": "Audit Logs",
      "item": [
        {
          "name": "List Audit Logs (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/audit?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["audit"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "userId", "value": "", "disabled": true },
                { "key": "action", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Audit Log By ID (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/audit/:id",
              "host": ["{{baseUrl}}"],
              "path": ["audit", ":id"],
              "variable": [{ "key": "id", "value": "<audit_log_id>" }]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/stats", "host": ["{{baseUrl}}"], "path": ["admin", "stats"] }
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/users?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Toggle User Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/users/:id/status",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users", ":id", "status"],
              "variable": [{ "key": "id", "value": "<user_id>" }]
            }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/users/:id",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users", ":id"],
              "variable": [{ "key": "id", "value": "<user_id>" }]
            }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    }
  ]
}
