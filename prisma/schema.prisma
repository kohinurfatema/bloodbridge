generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DONOR
  REQUESTER
  ADMIN
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum Urgency {
  NORMAL
  URGENT
  EMERGENCY
}

enum RequestStatus {
  PENDING
  MATCHED
  FULFILLED
  CANCELLED
}

enum MatchStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model User {
  id            String       @id @default(uuid())
  name          String
  email         String       @unique
  password      String?
  role          Role         @default(REQUESTER)
  phone         String?
  isActive      Boolean      @default(true)
  isVerified    Boolean      @default(false)
  googleId      String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  donorProfile  DonorProfile?
  requests      BloodRequest[]
  matches       DonationMatch[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([role])
  @@index([deletedAt])
}

model DonorProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  bloodType         BloodType
  location          String
  isAvailable       Boolean   @default(true)
  lastDonationDate  DateTime?
  totalDonations    Int       @default(0)
  medicalNotes      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id])
  matches           DonationMatch[]

  @@index([bloodType])
  @@index([location])
  @@index([isAvailable])
}

model BloodRequest {
  id            String        @id @default(uuid())
  requesterId   String
  bloodType     BloodType
  units         Int           @default(1)
  urgency       Urgency       @default(NORMAL)
  status        RequestStatus @default(PENDING)
  location      String
  hospital      String?
  notes         String?
  requiredDate  DateTime
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  requester     User          @relation(fields: [requesterId], references: [id])
  matches       DonationMatch[]
  payment       Payment?
  alert         EmergencyAlert?

  @@index([bloodType])
  @@index([status])
  @@index([urgency])
  @@index([deletedAt])
}

model DonationMatch {
  id            String      @id @default(uuid())
  requestId     String
  donorId       String
  donorProfileId String
  status        MatchStatus @default(PENDING)
  scheduledDate DateTime?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  request       BloodRequest  @relation(fields: [requestId], references: [id])
  donor         User          @relation(fields: [donorId], references: [id])
  donorProfile  DonorProfile  @relation(fields: [donorProfileId], references: [id])

  @@unique([requestId, donorId])
  @@index([status])
}

model Payment {
  id               String        @id @default(uuid())
  requestId        String        @unique
  amount           Float
  currency         String        @default("usd")
  status           PaymentStatus @default(PENDING)
  stripeSessionId  String?       @unique
  transactionId    String?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  request          BloodRequest  @relation(fields: [requestId], references: [id])

  @@index([status])
}

model EmergencyAlert {
  id             String   @id @default(uuid())
  requestId      String   @unique
  notifiedCount  Int      @default(0)
  isResolved     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  request        BloodRequest @relation(fields: [requestId], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  resource    String
  resourceId  String?
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
}
